/* BlackArch Toolbox — rofi theme (v2, refined)
 *
 * Red-on-near-black identity, but everything is given room to breathe: a taller
 * brand bar, generous row padding, a clear active-row treatment (brighter fill,
 * a solid accent bar, bright text), and a hairline inner structure so the menu
 * reads as one deliberate surface instead of a cramped list. Neutrals are warmed
 * toward the accent so nothing looks like flat GTK grey.
 */

* {
    blood:       #ff2b2b;   /* primary accent — border, active bar, counts   */
    blood-soft:  #c81f22;
    ember:       #ff7a45;   /* secondary — highlights, keys                  */
    bg:          #0b0708;   /* window base                                   */
    bg-inputs:   #17090a;   /* brand / input bar                             */
    bg-alt:      #100a0b;   /* message strip, scrollbar trough               */
    row-sel:     #2a0b0e;   /* active row fill                               */
    fg:          #f4ecec;   /* bright body                                   */
    fg-dim:      #b09a9a;   /* tool descriptions / package names             */
    fg-faint:    #6a5555;   /* counts, hints                                 */
    transparent: rgba(0,0,0,0);

    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    background-color: @bg;
    border:           2px;
    border-color:     @blood;
    border-radius:    16px;
    width:            560px;   /* compact, as before */
    padding:          0px;

    /* Flush to the top-left corner, just under the waybar. */
    location:         north west;
    anchor:           north west;
    x-offset:         10px;
    y-offset:         8px;
}

mainbox {
    children: [ "inputbar", "message", "listview" ];
    spacing:  0px;
    padding:  0px;
}

/* Brand bar: the BlackArch lockup sits on the prompt widget; the entry is the
   live search field beside it. */
inputbar {
    background-color: @bg-inputs;
    border-radius:    14px 14px 0px 0px;
    border:           0px 0px 1px 0px;
    border-color:     @blood;
    padding:          16px 18px;
    spacing:          14px;
    children:         [ "prompt", "entry" ];
}

/* The BlackArch lockup. The image scales to this width, so a larger width = a
   bigger, more prominent logo/wordmark. */
prompt {
    expand:           false;
    width:            420px;
    text-color:       transparent;
    background-color: transparent;
    background-image: url("@@BAT_ASSETS@@/brand_rofi.png", width);
    vertical-align:   0.5;
}

entry {
    text-color:        @fg;
    placeholder:       "type to filter…";
    placeholder-color: @fg-faint;
    vertical-align:    0.5;
    cursor:            text;
    padding:           2px 0px;
}

/* Usage hint strip under the brand bar. */
message {
    background-color: @bg-alt;
    border:           0px 0px 1px 0px;
    border-color:     #21100f;
    padding:          9px 22px;
}
textbox {
    text-color: @fg-dim;
    font:       "JetBrainsMono Nerd Font 10";
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            13;
    spacing:          2px;
    padding:          8px 8px;
    scrollbar:        true;
    fixed-height:     false;
    dynamic:          true;
}

scrollbar {
    handle-color:     @blood-soft;
    handle-width:     4px;
    background-color: @bg-alt;
}

element {
    padding:       9px 14px;
    border-radius: 8px;
    spacing:       12px;
    cursor:        pointer;
}

element normal.normal    { background-color: transparent; text-color: @fg-dim; }
element alternate.normal { background-color: transparent; text-color: @fg-dim; }

element selected.normal {
    background-color: @row-sel;
    text-color:       @fg;
    border:           0px 0px 0px 3px;
    border-color:     @blood;
}

element-icon {
    size:             0px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        bold #ff7a45;   /* live fuzzy-match highlight */
}
