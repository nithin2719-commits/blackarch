	optdepends = dmenu: graphical menu on X11
	optdepends = fzf: terminal menu, for SSH and TTY use
	optdepends = kitty: themed terminal for the per-tool view
	optdepends = papirus-icon-theme: BlackArch icon for the menu
	optdepends = libnotify: launch notifications
