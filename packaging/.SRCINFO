pkgbase = blackarch-toolbox
	pkgdesc = Search-first launcher for the security tools installed on your machine
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/nithin2719-commits/blackarch_toolbox
	install = blackarch-toolbox.install
	arch = any
	license = MIT
	depends = bash
	depends = awk
	optdepends = rofi: graphical menu on X11/Wayland (the default)
